# App Base URL (Update to your live production domain on Vercel)
NEXT_PUBLIC_APP_URL="https://himalayanenergyexpo.com"

# Nodemailer — SMTP Settings for Pass Badges & Inquiries
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="eventsolutiones@gmail.com"
SMTP_PASS="your-gmail-app-password"
SMTP_FROM_NAME="Himalayan Green Energy Expo 2027"

# Admin & staff login
# AUTH_SECRET signs login sessions. Generate one with:  openssl rand -base64 32
AUTH_SECRET="generate-a-random-32+-character-secret"
# Password for the built-in admin accounts (admin, admin@hydroexpo.org.np, …). Min 8 characters.
ADMIN_PASSWORD="choose-a-strong-password-min-8-chars"
# Gate staff: password for the "staff" accounts, and the quick gate passcode. Min 6 characters each.
STAFF_PASSWORD="choose-a-staff-password"
STAFF_PASSCODE="choose-a-gate-passcode"

# Khalti Payment Gateway (v2) - Merchant Live Credentials
KHALTI_SECRET_KEY=""
KHALTI_BASE_URL="https://khalti.com/api/v2"


# QR pass encryption. Must be a NEW random secret (the old value was public in the code).
# Generate with:  openssl rand -base64 32
PASS_SECRET_KEY="generate-a-new-random-secret"
# Optional: old key(s), comma-separated, so passes issued before the change still scan. Remove once those passes are re-sent.
PASS_SECRET_KEY_PREVIOUS=""

# Firebase Admin SDK — service-account JSON (raw or base64) from Firebase console →
# Project settings → Service accounts → Generate new private key. Required before deploying firestore.locked.rules.
FIREBASE_SERVICE_ACCOUNT=""

# Weekly traffic report (Vercel cron, Mondays 09:00 Nepal time)
CRON_SECRET="generate-a-random-secret"
REPORT_EMAILS="info@himalayanenergyexpo.com"

# Optional: AI model for traffic suggestions (Vercel AI Gateway). Auth is automatic on Vercel.
AI_GATEWAY_MODEL="anthropic/claude-haiku-5.5"
